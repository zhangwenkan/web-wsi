{
   "editor.formatOnSave": true,
   "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.fixAll.stylelint": "explicit"
   },
   "eslint.validate": [
      "javascript",
      "javascriptreact",
      "typescript",
      "typescriptreact",
      "vue"
   ],
   "stylelint.validate": [
      "css",
      "scss",
      "less",
      "vue"
   ],
   "typescript.tsdk": "node_modules/typescript/lib"
}